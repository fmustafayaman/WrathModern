# Run with: cmake -P Tools/MacDev/test-cmake-options.cmake
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ProjectOptions.cmake")

function(check_setting expected)
    wowremac_cache_setting(TEST_OPTION TEST_LEGACY STRING "Test option" "default")
    foreach (name TEST_OPTION TEST_LEGACY)
        if (NOT "${${name}}" STREQUAL "${expected}")
            message(FATAL_ERROR "${name}: expected '${expected}', got '${${name}}'")
        endif ()
    endforeach ()
endfunction()

check_setting("default")
set(TEST_LEGACY "legacy/path with spaces" CACHE STRING "" FORCE)
check_setting("legacy/path with spaces")
set(TEST_OPTION "canonical" CACHE STRING "" FORCE)
check_setting("canonical")
set(TEST_LEGACY "other" CACHE STRING "" FORCE)
set(TEST_OPTION "explicit" CACHE STRING "" FORCE)
check_setting("explicit")
set(TEST_OPTION "" CACHE STRING "" FORCE)
check_setting("")
set(TEST_LEGACY "legacy-again" CACHE STRING "" FORCE)
check_setting("legacy-again")
set(TEST_LEGACY "" CACHE STRING "" FORCE)
check_setting("")

unset(TEST_OPTION CACHE)
unset(_TEST_OPTION_PREVIOUS CACHE)
set(TEST_LEGACY "migrated" CACHE STRING "" FORCE)
check_setting("migrated")

set(TEST_BOOL_LEGACY OFF CACHE BOOL "")
wowremac_cache_setting(TEST_BOOL TEST_BOOL_LEGACY BOOL "Test boolean" ON)
if (TEST_BOOL OR TEST_BOOL_LEGACY)
    message(FATAL_ERROR "An explicitly disabled legacy boolean was not preserved")
endif ()
get_property(hidden CACHE TEST_BOOL_LEGACY PROPERTY ADVANCED)
if (NOT hidden)
    message(FATAL_ERROR "Compatibility aliases should not clutter the public options")
endif ()
message(STATUS "WoWReMac CMake option compatibility: 10 checks passed")
